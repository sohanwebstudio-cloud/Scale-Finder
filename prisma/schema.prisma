generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SavedScale {
  id        String   @id @default(cuid())
  userId    String
  root      String
  scaleName String
  createdAt DateTime @default(now())

  @@unique([userId, root, scaleName])
  @@index([userId])
}
